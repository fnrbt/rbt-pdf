<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Rbt.Pdf.fs" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true' and '$(ForgePublish)' != 'true'">
    <ProjectReference Include="../../rbt-text/opentype/Rbt.OpenType.Core.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true' and '$(ForgePublish)' == 'true'">
    <PackageReference Include="Rbt.OpenType.Core" Version="$(RbtTextPackageVersion)" />
  </ItemGroup>
  <!-- Development builds use the sibling checkout; published packages depend on
       the released package (an exact, existing version, not this repo's). -->
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true' and '$(ForgePublish)' != 'true'">
    <ProjectReference Include="../../rbt-text/opentype/Rbt.OpenType.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true' and '$(ForgePublish)' == 'true'">
    <PackageReference Include="Rbt.OpenType" Version="0.1.1" />
  </ItemGroup>
  <!-- Ship the F# sources under fable/ so Fable can compile this library from
       the NuGet package alone (for example in a Forge build sandbox). -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectFullPath)" PackagePath="fable/" Pack="true" Visible="false" />
    <Content Include="@(Compile)" PackagePath="fable/%(RelativeDir)" Pack="true" Visible="false" />
  </ItemGroup>
</Project>
