<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Rbt.Pdf.fs" />
  </ItemGroup>
  <!-- Font utilities and image/stream codecs come from shared packages, including
       their F# sources for Fable builds. PDF-specific recovery policy stays here. -->
  <ItemGroup>
    <PackageReference Include="Rbt.OpenType.Core" Version="$(RbtTextPackageVersion)" />
    <PackageReference Include="Rbt.Image" Version="$(RbtImagePackageVersion)" />
  </ItemGroup>
  <!-- Ship the F# sources under fable/ so Fable can compile this library from
       the NuGet package alone (for example in a Forge build sandbox). -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectFullPath)" PackagePath="fable/" Pack="true" Visible="false" />
    <Content Include="@(Compile)" PackagePath="fable/%(RelativeDir)" Pack="true" Visible="false" />
  </ItemGroup>
</Project>
