<Project>
  <PropertyGroup>
    <!-- Published packages declare the FSharp.Core they compiled against as a minimum.
         Pin it, rather than inheriting the build SDK's, so every consumer (RedBat pins
         10.1.302) satisfies it; matches Rbt.Pdf 0.1.1 and the other Rbt packages. -->
    <FSharpCoreImplicitPackageVersion Condition="'$(FABLE_COMPILER)' != 'true'">10.0.111</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <!-- Fable builds in a Forge sandbox (ForgePublish=true) have only this
       repository, so the sibling libraries come from the package registry;
       those packages carry their F# sources under fable/. -->
  <PropertyGroup>
    <RbtTextPackageVersion Condition="'$(RbtTextPackageVersion)' == ''">0.1.5</RbtTextPackageVersion>
    <RbtRendererCorePackageVersion Condition="'$(RbtRendererCorePackageVersion)' == ''">0.1.2</RbtRendererCorePackageVersion>
  </PropertyGroup>
</Project>
