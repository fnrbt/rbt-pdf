<Project>
  <PropertyGroup>
    <!-- Use the dependency packages' minimum FSharp.Core version in both native
         and Fable restores; the SDK default can otherwise cause NU1605. -->
    <FSharpCoreImplicitPackageVersion>10.1.403</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <!-- The text libraries and the renderer come from the package registry in
       every build; nothing refers to a neighbouring checkout. The packages a
       Fable build uses carry their F# sources under fable/. -->
  <PropertyGroup>
    <RbtTextPackageVersion Condition="'$(RbtTextPackageVersion)' == ''">0.1.7</RbtTextPackageVersion>
    <RbtRendererCorePackageVersion Condition="'$(RbtRendererCorePackageVersion)' == ''">0.1.7</RbtRendererCorePackageVersion>
    <RbtRendererPackageVersion Condition="'$(RbtRendererPackageVersion)' == ''">0.1.7</RbtRendererPackageVersion>
    <RbtImagePackageVersion Condition="'$(RbtImagePackageVersion)' == ''">0.1.2</RbtImagePackageVersion>
  </PropertyGroup>
</Project>
