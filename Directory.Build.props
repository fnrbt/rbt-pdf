<Project>
  <PropertyGroup>
    <!-- Published packages declare the FSharp.Core they compiled against as a minimum.
         Pin it, rather than inheriting the build SDK's, so every consumer (RedBat pins
         10.1.302) satisfies it; matches Rbt.Pdf 0.1.1 and the other Rbt packages. -->
    <FSharpCoreImplicitPackageVersion Condition="'$(FABLE_COMPILER)' != 'true'">10.1.402</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <!-- The text libraries and the renderer come from the package registry in
       every build; nothing refers to a neighbouring checkout. The packages a
       Fable build uses carry their F# sources under fable/. -->
  <PropertyGroup>
    <RbtTextPackageVersion Condition="'$(RbtTextPackageVersion)' == ''">0.1.6</RbtTextPackageVersion>
    <RbtRendererCorePackageVersion Condition="'$(RbtRendererCorePackageVersion)' == ''">0.1.4</RbtRendererCorePackageVersion>
    <RbtRendererPackageVersion Condition="'$(RbtRendererPackageVersion)' == ''">0.1.4</RbtRendererPackageVersion>
  </PropertyGroup>
</Project>
