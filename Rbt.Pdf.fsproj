<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Rbt.Pdf.fs" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true'">
    <ProjectReference Include="../rbt-text/opentype/Rbt.OpenType.Core.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true'">
    <ProjectReference Include="../rbt-text/opentype/Rbt.OpenType.fsproj" />
  </ItemGroup>
</Project>
