<Project>
  <!--
    When ForgePublish=true (ephemeral CI with no sibling repos), convert any
    ProjectReference pointing outside this repository to a PackageReference.
    Convention: fsproj filename == NuGet package ID.
  -->
  <Target Name="_ConvertExternalProjectRefsForPublish"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(ForgePublish)' == 'true'">
    <ItemGroup>
      <_ExternalRef Include="@(ProjectReference)"
                    Condition="!$([System.IO.Path]::GetFullPath('%(Identity)').StartsWith('$(MSBuildThisFileDirectory)'))" />
      <ProjectReference Remove="@(_ExternalRef)" />
      <PackageReference Include="%(_ExternalRef.Filename)" Version="*" />
    </ItemGroup>
  </Target>
</Project>
