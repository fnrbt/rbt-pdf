<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ImageDecode.fs" Condition="'$(FABLE_COMPILER)' != 'true'" />
    <Compile Include="Fonts.fs" />
    <Compile Include="Render.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rbt.Pdf/Rbt.Pdf.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true' and '$(ForgePublish)' != 'true'">
    <ProjectReference Include="../../rbt-renderer/Rbt.Renderer.Core.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true' and '$(ForgePublish)' == 'true'">
    <PackageReference Include="Rbt.Renderer.Core" Version="$(RbtRendererCorePackageVersion)" />
  </ItemGroup>
  <!-- Development builds use the sibling checkout; published packages depend on
       the released package (an exact, existing version, not this repo's). -->
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true' and '$(ForgePublish)' != 'true'">
    <ProjectReference Include="../../rbt-renderer/Rbt.Renderer.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true' and '$(ForgePublish)' == 'true'">
    <!-- Render.fs needs Rbt.Renderer API newer than 0.1.1 (the latest release), so
         this package is not published until Rbt.Renderer is; bump then. -->
    <PackageReference Include="Rbt.Renderer" Version="0.1.1" />
  </ItemGroup>
</Project>
