<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ImageDecode.fs" />
    <Compile Include="BitmapPaint.fs" />
    <Compile Include="CcittDecode.fs" />
    <Compile Include="Jbig2Huffman.fs" />
    <Compile Include="Jbig2Bitmaps.fs" />
    <Compile Include="Jbig2Symbols.fs" />
    <Compile Include="Jbig2Segments.fs" />
    <Compile Include="Jbig2Decode.fs" />
    <Compile Include="JpxTagTrees.fs" />
    <Compile Include="JpxBitplane.fs" />
    <Compile Include="JpxWavelets.fs" />
    <Compile Include="JpxPackets.fs" />
    <Compile Include="JpxDecode.fs" />
    <Compile Include="PdfColor.fs" />
    <Compile Include="PdfImages.fs" />
    <Compile Include="Fonts.fs" />
    <Compile Include="PageGeometry.fs" />
    <Compile Include="PdfCalculator.fs" />
    <Compile Include="PdfSampled.fs" />
    <Compile Include="Shading.fs" />
    <Compile Include="Render.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../resources/**/*" Link="assets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rbt.Pdf/Rbt.Pdf.fsproj" />
  </ItemGroup>
  <!-- JPEG decoding (DCTDecode): managed, portable, carries its sources for Fable. -->
  <ItemGroup>
    <PackageReference Include="Rbt.Image" Version="$(RbtImagePackageVersion)" />
  </ItemGroup>
  <!-- The renderer comes from the package registry: the Fable-safe subset for
       a Fable build, the whole renderer for .NET. -->
  <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true'">
    <PackageReference Include="Rbt.Renderer.Core" Version="$(RbtRendererCorePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true'">
    <PackageReference Include="Rbt.Renderer" Version="$(RbtRendererPackageVersion)" />
  </ItemGroup>
</Project>
