<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="JpxRegression.fs" />
    <Compile Include="Program.fs" />
    <EmbeddedResource Include="jpx-tiled.base64" LogicalName="jpx-tiled.base64" />
    <EmbeddedResource Include="jpx-tiled-mct.base64" LogicalName="jpx-tiled-mct.base64" />
    <EmbeddedResource Include="vertical-cid.pdf" LogicalName="vertical-cid.pdf" />
    <EmbeddedResource Include="vertical-cid-default.pdf" LogicalName="vertical-cid-default.pdf" />
    <EmbeddedResource Include="icc-rgb-lut8-xyz-page.base64" LogicalName="icc-rgb-lut8-xyz-page.base64" />
    <EmbeddedResource Include="icc-rgb-lut16-lab-forms.base64" LogicalName="icc-rgb-lut16-lab-forms.base64" />
    <EmbeddedResource Include="ais-rgba-jpx.base64" LogicalName="ais-rgba-jpx.base64" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rbt.Pdf/Rbt.Pdf.fsproj" />
    <ProjectReference Include="../../Rbt.Pdf.Render/Rbt.Pdf.Render.fsproj" />
  </ItemGroup>
</Project>
